<Window x:Class="Poker.Advisor.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Poker Advisor"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="#01000000"
        Topmost="True"
        ShowInTaskbar="False"
        ResizeMode="NoResize"
        WindowState="Normal"
        Focusable="False"
        SnapsToDevicePixels="True"
        UseLayoutRounding="True">
    <Grid IsHitTestVisible="False">
        <Canvas x:Name="OverlayCanvasA"
                ClipToBounds="False"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Stretch" />
        <Canvas x:Name="OverlayCanvasB"
                ClipToBounds="False"
                Visibility="Collapsed"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Stretch" />

        <Border x:Name="StatusChip"
                HorizontalAlignment="Left"
                VerticalAlignment="Bottom"
                Margin="14,0,0,14"
                Padding="8,4"
                Background="#660A0C10"
                BorderBrush="#33FFFFFF"
                BorderThickness="1"
                CornerRadius="3">
            <TextBlock x:Name="StatusText"
                       Text="starting"
                       FontSize="11"
                       FontWeight="Medium"
                       Foreground="#99C8D0D8" />
        </Border>

        <StackPanel x:Name="AdvicePanelHost"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Top"
                    Margin="0,14,16,0"
                    MaxWidth="440" />
    </Grid>
</Window>
