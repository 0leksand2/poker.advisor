<Window x:Class="Poker.Advisor.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Poker Advisor"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="#01000000"
        Topmost="True"
        ShowInTaskbar="False"
        ResizeMode="NoResize"
        WindowState="Normal"
        Focusable="False"
        SnapsToDevicePixels="True"
        UseLayoutRounding="True">
    <Grid IsHitTestVisible="False">
        <Canvas x:Name="OverlayCanvasA"
                ClipToBounds="False"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Stretch" />
        <Canvas x:Name="OverlayCanvasB"
                ClipToBounds="False"
                Visibility="Collapsed"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Stretch" />

        <TextBlock x:Name="StatusText"
                   Text="Starting predictor..."
                   FontSize="14"
                   FontWeight="SemiBold"
                   Foreground="#E8FFCC00"
                   HorizontalAlignment="Left"
                   VerticalAlignment="Top"
                   Margin="16,12,0,0">
            <TextBlock.Effect>
                <DropShadowEffect BlurRadius="4" ShadowDepth="1" Opacity="0.8" Color="Black" />
            </TextBlock.Effect>
        </TextBlock>

        <Border x:Name="TableStatePanel"
                HorizontalAlignment="Right"
                VerticalAlignment="Top"
                Margin="0,16,20,0"
                Padding="14,12"
                Background="#CC101418"
                BorderBrush="#66FFCC00"
                BorderThickness="1"
                CornerRadius="4"
                MaxWidth="560">
            <TextBlock x:Name="TableStateText"
                       Text="table: waiting..."
                       FontFamily="Consolas"
                       FontSize="14"
                       Foreground="#F0F0F0"
                       TextWrapping="Wrap" />
        </Border>
    </Grid>
</Window>
