<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <!-- Exe file name + Task Manager / Details display name -->
    <AssemblyName>obsstudio</AssemblyName>
    <AssemblyTitle>OBS Studio</AssemblyTitle>
    <Product>OBS Studio</Product>
    <AssemblyDescription>OBS Studio</AssemblyDescription>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Poker.Advisor.Core\Poker.Advisor.Core.csproj" />
    <ProjectReference Include="..\Poker.Advisor.Services\Poker.Advisor.Services.csproj" />
  </ItemGroup>

</Project>
